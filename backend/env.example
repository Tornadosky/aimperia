# Server Configuration
NODE_ENV=development
PORT=4000

# Supabase Configuration
SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Agora Video SDK
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Agora Cloud Recording
AGORA_CUSTOMER_ID=your_agora_customer_id
AGORA_CUSTOMER_SECRET=your_agora_customer_secret
AGORA_STORAGE_VENDOR=1
AGORA_STORAGE_REGION=your_storage_region
AGORA_STORAGE_BUCKET=your_storage_bucket
AGORA_STORAGE_ACCESS_KEY=your_storage_access_key
AGORA_STORAGE_SECRET_KEY=your_storage_secret_key

# OpenAI Configuration - for audio transcription
OPENAI_API_KEY=your_openai_api_key_here

# ngrok (for development tunnel)
NGROK_AUTHTOKEN= 